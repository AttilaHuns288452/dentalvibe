# Supabase project credentials (publishable/anon values — safe for the browser).
# Copy to .env.local (gitignored) or set in Vercel → Environment Variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# VAPID PUBLIC key for Web Push (safe in the browser; the private key is server-only)
VITE_VAPID_PUBLIC_KEY=
